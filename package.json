{
  "name": "aegis",
  "private": true,
  "version": "0.1.0",
  "description": "Autonomous onchain incident response powered by TrueForge",
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "test:e2e": "vitest run tests/e2e",
    "format": "pnpm exec prettier --write .",
    "demo": "tsx scripts/demo.ts",
    "demo:incident": "tsx scripts/demo-incident.ts",
    "api": "pnpm --filter @aegis/api start",
    "db:generate": "pnpm --filter @aegis/database db:generate",
    "db:migrate": "pnpm --filter @aegis/database db:migrate",
    "build:sandbox": "tsx scripts/build-sandbox.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset.ts"
  },
  "dependencies": {
    "@aegis/incident-engine": "workspace:*",
    "@aegis/shared": "workspace:*",
    "@aegis/simulator": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.6.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.2.0"
  }
}
