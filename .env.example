# ============================================================
# AEGIS Environment
# Copy to .env and fill in. Never commit .env. Use placeholders only.
# `pnpm demo` runs with NONE of these set (deterministic local runtime).
# The API (Phase 2) requires DATABASE_URL / a running Postgres.
# ============================================================

NODE_ENV=development

# ---- API --------------------------------------------------
API_PORT=4000
# Comma-separated allowed origins for CORS (omit to reflect any origin in dev).
CORS_ORIGINS=

# ---- Auth -------------------------------------------------
# When true, protected resources require a valid session (401 otherwise).
# When false (dev/demo), unauthenticated requests resolve to a seeded dev user
# so the console + demo keep working. Wallet auth works either way.
AUTH_REQUIRED=false
# Secret used to sign session cookies (set a strong random value in production).
SESSION_SECRET=
# App base URL the OAuth callback redirects back to after login.
APP_BASE_URL=http://localhost:3000
# Google OAuth (optional — endpoints return 501 until all three are set).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback

# ---- Database (Phase 2) -----------------------------------
# Postgres via docker-compose (docker compose up -d postgres).
DATABASE_URL=postgresql://aegis:aegis@localhost:5544/aegis

# ---- Sandbox (Phase 2) ------------------------------------
# Preferred driver: docker (falls back to a locked-down subprocess when the
# daemon/image are unavailable). Build the image: pnpm build:sandbox
SANDBOX_IMAGE=aegis-sandbox:latest
# Force a driver: "docker" or "subprocess" (omit for auto).
SANDBOX_DRIVER=

# ---- Code Investigator (Phase 2) --------------------------
# Root of the code fixture (defaults to ./fixtures/demo-app).
CODE_FIXTURE_ROOT=

# ---- Blockchain (optional) --------------------------------
# If set, the Blockchain Investigator reads REAL Base Sepolia (read-only, no key).
BASE_SEPOLIA_RPC_URL=
BASE_SEPOLIA_CHAIN_ID=84532

# ---- Multichain mainnet RPCs (optional) -------------------
# Read-only endpoints per chain. Omit to use a public default for that chain
# (EVM → viem public RPC; Solana → api.mainnet-beta.solana.com; Stacks → api.hiro.so).
CHAIN_RPC_ETHEREUM=
CHAIN_RPC_BASE=
CHAIN_RPC_ARBITRUM=
CHAIN_RPC_OPTIMISM=
CHAIN_RPC_POLYGON=
# Non-EVM chains (native-balance / treasury monitoring):
CHAIN_RPC_SOLANA=
CHAIN_RPC_STACKS=

# ---- Monitoring (optional, opt-in) ------------------------
# Background monitor: polls registered contracts/treasury on their mainnet
# chains and auto-launches an investigation on large movements. Requires RPC.
MONITOR_ENABLED=false
MONITOR_INTERVAL_MS=30000
# Default alert threshold in wei (per-protocol override: monitoring config
# `transferThresholdWei`). Default 1e18 (~1 native token).
MONITOR_DEFAULT_THRESHOLD_WEI=1000000000000000000

# ---- TrueForge / Agent Harness (optional) -----------------
# If both are set, Aegis runs a REAL TrueForge Agent Harness session; otherwise
# it uses the deterministic local runtime.
TRUEFORGE_API_URL=
TRUEFORGE_API_KEY=
TRUEFORGE_COMMANDER_AGENT=aegis-commander
